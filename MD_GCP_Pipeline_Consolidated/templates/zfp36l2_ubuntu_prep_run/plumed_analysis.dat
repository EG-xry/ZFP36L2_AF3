RESTART
MOLINFO MOLTYPE=protein STRUCTURE=input_af.pdb
WHOLEMOLECULES ENTITY0=1-316

Rg: GYRATION TYPE=RADIUS ATOMS=1-316
RMSD1: RMSD REFERENCE=struct1.pdb TYPE=OPTIMAL
RMSD2: RMSD REFERENCE=struct2.pdb TYPE=OPTIMAL
RMSD3: RMSD REFERENCE=struct3.pdb TYPE=OPTIMAL
# PBMetaD
PBMETAD ...
    LABEL=pb
    ARG=Rg
    SIGMA=1000
    SIGMA_MIN=0.05
    SIGMA_MAX=0.2
    ADAPTIVE=DIFF
    HEIGHT=0.3
    PACE=20000000
    BIASFACTOR=15
    GRID_MIN=0.01
    GRID_MAX=50.0
    GRID_WSTRIDE=5000
    WALKERS_MPI
    TEMP=298
... PBMETAD
PRINT ARG=pb.bias FILE=FULLBIAS STRIDE=1
PRINT FILE=COLVAR ARG=Rg,RMSD1,RMSD2,RMSD3 STRIDE=1
ENDPLUMED
